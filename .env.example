# Copy this file to .env.local and set real values there.
# Never commit .env.local or paste secret values into reports/logs.

# Extraction and relation-analysis LLM (OpenAI-compatible)
ACADEMIC_LANDSCAPE_BASE_URL=https://api.deepseek.com/v1
ACADEMIC_LANDSCAPE_MODEL=deepseek-v4-flash
ACADEMIC_LANDSCAPE_API_KEY=

# Default embedding route for `academic-landscape landscape`
# The CLI defaults to --embedding-backend siliconflow.
SILICONFLOW_API_KEY=
SILICONFLOW_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# Offline alternative, only when explicitly requested:
# academic-landscape landscape ... --embedding-backend local \
#   --local-embedding-model BAAI/bge-small-en-v1.5 --embedding-device auto
